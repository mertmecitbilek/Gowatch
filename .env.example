# GoWatch Configuration

# Server
PORT=8080
GIN_MODE=release

# Session
# Boş bırakılırsa rastgele bir anahtar üretilir ve veritabanının yanındaki session.key dosyasına kaydedilir.
# Elle vermek için: openssl rand -hex 32
SESSION_SECRET=

# İlk kurulumda oluşturulan admin hesabı.
# ADMIN_PASSWORD boş bırakılırsa rastgele bir şifre üretilir ve loglarda bir kez gösterilir.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# HTTPS arkasında çalışıyorsa true yapın (çerez yalnızca HTTPS ile gönderilir)
COOKIE_SECURE=false

# Reverse proxy kullanılıyorsa proxy'nin IP adresi/ağı (virgülle ayrılmış). Boşsa X-Forwarded-For dikkate alınmaz.
TRUSTED_PROXIES=

# Yerel ağdaki/iç adreslerdeki (localhost, 10.x, 192.168.x vb.) servislerin izlenmesine izin ver.
# Herkese açık kayıtlı kurulumlarda false bırakın (SSRF koruması).
ALLOW_PRIVATE_TARGETS=false

# Kullanıcı başına en fazla monitör sayısı (0 = sınırsız)
MAX_MONITORS_PER_USER=100
